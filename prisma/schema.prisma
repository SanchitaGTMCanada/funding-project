generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  EMPLOYEE
  SUPER_ADMIN
}

enum ApplicationStatus {
  NEW
  CONTACTED
  IN_REVIEW
  APPROVED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  activityLogs ActivityLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model FundingService {
  id          Int     @id @default(autoincrement())
  title       String
  description String? @db.Text
  data        Json

  whoYouAre Json?
  territory Json?
  category  Json?

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  applications Application[]

  @@map("funding_services")
}

model Application {
  id               Int               @id @default(autoincrement())
  fundingServiceId Int
  name             String
  phone            String
  email            String
  company          String?
  address          String?           @db.Text
  city             String?
  message          String?           @db.Text
  status           ApplicationStatus @default(NEW)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  fundingService FundingService @relation(fields: [fundingServiceId], references: [id], onDelete: Cascade)

  @@index([fundingServiceId])
  @@map("applications")
}

model ActivityLog {
  id Int @id @default(autoincrement())

  // User information
  userId   Int?
  userName String?
  userRole String?

  // Activity information
  action      String
  module      String
  description String @db.Text

  // Affected record
  entityId   String?
  entityName String?

  // Before and after values
  oldValues Json?
  newValues Json?

  // Request details
  ipAddress String?
  userAgent String? @db.Text

  // USER, SYSTEM, AUTOMATION
  source String @default("USER")

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([action, createdAt])
  @@index([entityId])
  @@index([createdAt])
  @@map("activity_logs")
}
